# Copy to .env.local and fill in. Never commit real secrets.
# Same variable names locally and in Vercel; only the values change.

# Public canonical URL (metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Leave the URL and the secret key empty to use the in-memory
# waitlist mock. For local development, use the LOCAL Supabase
# (`pnpm db:start`, values from `pnpm db:status`). Production values live only
# in Vercel, never here. Restart `pnpm dev` after changing.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_URL=
# The secret key (sb_secret_...), read only by the server. Never prefix it with
# NEXT_PUBLIC_: that would ship it to the browser.
SUPABASE_SECRET_KEY=

# The publishable key (sb_publishable_...). The app doesn't use it: the
# waitlist table blocks it. The integration tests use the LOCAL one to prove
# that.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# News providers for the preview's news card, tried in order: Massive, then
# Finnhub, then simulated headlines (when both are empty or both fail). Read
# only by the server: never prefix them with NEXT_PUBLIC_. Same names locally
# and in Vercel.
#
# Massive (formerly Polygon.io), the main source: real cover images. Free key
# at https://massive.com. Licensing: individual plans are for "personal,
# non-commercial" use; showing headlines to users needs a Business plan.
MASSIVE_API_KEY=
# Finnhub, the backup (https://finnhub.io). Licensing: free plans are
# "strictly for personal use"; redistribution needs written approval.
FINNHUB_API_KEY=

# Production project ref (not a secret: it's in the project URL). Read only by
# `pnpm db:migrate:prod`, which asks for the database password at run time.
SUPABASE_PROD_PROJECT_REF=
