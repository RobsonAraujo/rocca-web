# Copy to .env.local and fill in. Never commit real secrets.

# Public canonical URL (metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (server-only). Leave both empty to use the in-memory waitlist mock.
# Set both to persist signups in Supabase. Restart `pnpm dev` after changing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
